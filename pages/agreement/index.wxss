.page {
  height: 100vh;
  padding: 32rpx 32rpx 220rpx;
  box-sizing: border-box;
  background: #fff;
}

.title { font-size: 44rpx; font-weight: 700; color: #0b5132; text-align: center; margin-top: 16rpx; }
.intro { display: block; margin-top: 24rpx; font-size: 30rpx; color: #4c6b5c; line-height: 1.8; }
.agreed { display: block; margin-top: 16rpx; font-size: 28rpx; color: #1abc8c; }

.section { margin-top: 40rpx; }
.h { display: block; font-size: 34rpx; font-weight: 600; color: #0b5132; }
.p { display: block; margin-top: 12rpx; font-size: 30rpx; color: #4c6b5c; line-height: 1.8; }
.p.date { margin-top: 24rpx; color: #9ab3a3; }

.pad { height: 40rpx; }

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.btn { flex: 1; border-radius: 50rpx; padding: 24rpx; font-size: 34rpx; font-weight: 600; }
.primary { background: #1abc8c; color: #fff; border: none; }
.ghost { background: #f2f6f4; color: #6f8a7b; border: none; }
